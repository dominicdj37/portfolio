{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(/**/.env*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(type *.env*)",
      "PowerShell(Get-Content *.env*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:refs/heads/main)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel * --prod*)",
      "Bash(pnpm dlx *)",
      "Bash(npx *)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(npx *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm remove *)",
      "PowerShell(pnpm update *)",
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/docs/adr/**)",
      "Edit(/package.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/tsconfig.json)",
      "Edit(/eslint.config.*)",
      "Edit(/.prettierrc.json)",
      "Edit(/.prettierignore)",
      "Edit(/vitest.config.*)",
      "Edit(/playwright.config.*)",
      "Edit(/lighthouserc.json)"
    ],
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm start *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test *)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm e2e:mobile *)",
      "Bash(pnpm lhci)",
      "Bash(pnpm verify)",
      "Bash(pnpm verify:full)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(gh issue view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Edit(/app/**)",
      "Edit(/components/**)",
      "Edit(/content/**)",
      "Edit(/data/**)",
      "Edit(/lib/**)",
      "Edit(/styles/**)",
      "Edit(/public/**)",
      "Edit(/scripts/**)",
      "Edit(/tests/**)",
      "Edit(/docs/specs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-write.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
