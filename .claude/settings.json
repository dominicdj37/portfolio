{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "PowerShell(pnpm *)",
      "Bash(git *)",
      "PowerShell(git *)",
      "Bash(gh *)",
      "PowerShell(gh *)",
      "Edit(/**)",
      "Write(/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-write.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
